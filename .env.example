# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://qnzvembvucbbfvzmjzhk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FAwKvv90JRC15iJjU6RPEA_A_4Ey5hg
# Chave secreta (service_role / secret key). Só no servidor. Usada pelo webhook do Stripe.
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Opcional: troque por claude-sonnet-5-5 ou claude-haiku-5-5 para gastar menos
CLAUDE_MODEL=claude-opus-5-5
# Limite de pedidos de IA por pessoa por dia
AI_DAILY_LIMIT=40

# Stripe (dashboard.stripe.com > Developers > API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: ID de um preço criado no Stripe. Sem ele, cobra R$ 29,90/mês automaticamente.
STRIPE_PRICE_ID=

# Endereço público do site, sem barra no final (ex.: https://rota-de-estudo.vercel.app).
# Pode deixar vazio: o site usa o endereço pelo qual foi acessado.
NEXT_PUBLIC_SITE_URL=
